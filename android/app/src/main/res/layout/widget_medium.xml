<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- AnalogClock keeps ticking on its own (system-driven, like TextClock)
         with no help from the app. The alarm hand can't live inside it —
         AnalogClock only supports hour/minute drawables — so it's a
         same-bounds ImageView stacked on top instead, rotated in Kotlin via
         setFloat(..., "setRotation", angle). Takes all the width the text
         column doesn't need, and the full widget height. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <AnalogClock
            android:id="@+id/widget_clock_analog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:dial="@drawable/widget_clock_dial"
            android:hand_hour="@drawable/widget_clock_hand_hour"
            android:hand_minute="@drawable/widget_clock_hand_minute" />

        <ImageView
            android:id="@+id/widget_clock_hand_alarm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_clock_hand_alarm"
            android:visibility="gone"
            android:contentDescription="@null" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- TextClock's "a" (AM/PM) symbol is locale-driven — on a Korean
             device it always renders "오전/오후" no matter what pattern we
             ask for, with no way to force English while it keeps ticking
             on its own. So the AM/PM label is separate, plain TextViews
             that Kotlin sets in English — everything that actually needs
             to stay accurate every minute (h:mm) is still the native,
             self-ticking part.

             Two stacked TextViews (not one TextView with a "\n") because a
             single multi-line TextView's line-height math (needed to fit
             two lines snugly) clips/overlaps bold glyphs at small sizes —
             looked broken. Two independent views is pixel-exact instead:
             includeFontPadding="false" strips each glyph's internal
             leading so they stack with no gap and no overlap, and the
             whole block gets centered against the time by the parent
             row's gravity="center_vertical" — same alignment mechanism,
             just without the multi-line clipping. Bottom letter is always
             "M" (both AM and PM end in it), so only the top letter changes. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Fixed width+gravity=center (not wrap_content) so "A"/"P"
                     and "M" each render inside the exact same size box —
                     otherwise the narrower glyph (e.g. "P") sits in a
                     smaller box than "M" and the two lines don't line up
                     underneath each other. -->
                <TextView
                    android:id="@+id/widget_meridiem_top"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2B2620" />

                <TextView
                    android:id="@+id/widget_meridiem_bottom"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="M"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2B2620" />

            </LinearLayout>

            <TextClock
                android:id="@+id/widget_clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="h:mm"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#2B2620" />

        </LinearLayout>

        <!-- Bounded (0dp+weight, not wrap_content) so autosize has an actual
             box to shrink the font within — it picks the largest size where
             the *whole* quote fits, wrapped across as many lines as it
             needs, instead of a fixed size that clips long quotes with
             an ellipsis. -->
        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:text="문장을 불러오는 중이에요"
            android:textColor="#4A4038"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp" />

    </LinearLayout>

</LinearLayout>

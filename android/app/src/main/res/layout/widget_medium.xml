<?xml version="1.0" encoding="utf-8"?>
<!-- Clock top-left, time top-right of the clock (same row), quote spanning
     the full width below both — one fixed arrangement regardless of how
     the widget gets resized (no more switching between a side-by-side and
     a stacked layout based on aspect ratio). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- weight="5" here vs. the quote's weight="4" below — gives the clock
         row more of the available height than a plain 1:1 split, since the
         clock (a square, per AnalogClock's own uniform-scale drawing) is
         always bounded by whichever of width/height is smaller, and this
         row's height was that binding constraint. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal">

        <!-- Clock section: its own column (not just "whatever's left after
             the time column"), so the clock is centered *within this
             section* specifically, both axes — matches the time section
             below being centered within its own space instead of the two
             floating at arbitrary positions relative to each other. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6.8">

            <!-- AnalogClock keeps ticking on its own (system-driven, like
                 TextClock) with no help from the app. The dial drawable's
                 own canvas is now a genuine 4:3 rectangle (not a square
                 letterboxed inside a wide box, which is what match_parent
                 gave before — width and height diverged so it always got
                 capped by whichever was smaller). wrap_content instead
                 lets AnalogClock's own onMeasure size the view to that same
                 4:3 aspect, scaled up to the largest box that fits this
                 column — i.e. it actually fills the column now instead of
                 floating inside it. gravity="center" centers that box in
                 both axes if the column isn't exactly 4:3 itself.
                 The alarm hand can't live inside AnalogClock — it only
                 supports hour/minute/second drawables — so it's a same-
                 bounds ImageView stacked on top instead, rotated in Kotlin
                 via setFloat(..., "setRotation", angle). Its own drawable
                 is generated on the identical 1600x1200 canvas as the dial,
                 so adjustViewBounds resolves it to the exact same size as
                 the AnalogClock next to it without any manual syncing. -->
            <AnalogClock
                android:id="@+id/widget_clock_analog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:dial="@drawable/widget_clock_dial"
                android:hand_hour="@drawable/widget_clock_hand_hour"
                android:hand_minute="@drawable/widget_clock_hand_minute"
                android:hand_second="@drawable/widget_clock_hand_second" />

            <ImageView
                android:id="@+id/widget_clock_hand_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:src="@drawable/widget_clock_hand_alarm"
                android:visibility="gone"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- Time section: its own column too, with gravity="center_vertical|start"
             so the AM/PM + digital time block sits vertically centered within
             this section while hugging its left edge — AM/PM stacks above the
             digital time (vertical orientation, both left-aligned) so it reads
             as sitting at the time's upper-left corner rather than beside it.
             weight="3.2" (was "2" out of a clock:time ratio of 3:2, i.e.
             this column's own share of the row is now 20% smaller than
             before — 0.32 vs 0.4) shrinks this column itself; the text
             inside stays its original size, gravity just has less room to
             center it within now.
             TextClock's "a" (AM/PM) symbol is locale-driven — on a Korean
             device it always renders "오전/오후" no matter what pattern we
             ask for, with no way to force English while it keeps ticking on
             its own. So the AM/PM label is a separate, plain TextView that
             Kotlin sets in English — everything that actually needs to stay
             accurate every minute (h:mm) is still the native, self-ticking
             part. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/widget_meridiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AM"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2B2620" />

            <TextClock
                android:id="@+id/widget_clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="h:mm"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#2B2620" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bounded (0dp+weight, not wrap_content) so autosize has an actual
         box to shrink the font within — it picks the largest size where
         the *whole* quote fits, instead of a fixed size that clips long
         quotes with an ellipsis. Side margins keep lines from stretching
         edge-to-edge when the widget is wide. -->
    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:text="문장을 불러오는 중이에요"
        android:textColor="#4A4038"
        android:gravity="center"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="26sp"
        android:autoSizeStepGranularity="1sp" />

</LinearLayout>

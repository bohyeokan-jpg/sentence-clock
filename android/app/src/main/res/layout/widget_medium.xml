<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Takes all the width the text column doesn't need, and the full
         widget height — fitCenter then makes it as large as that box
         allows while staying square, so it scales with however big the
         user actually makes this widget. -->
    <ImageView
        android:id="@+id/widget_clock_image"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/widget_clock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="a h:mm"
            android:format24Hour="a h:mm"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2B2620" />

        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="문장을 불러오는 중이에요"
            android:textSize="10.5sp"
            android:textColor="#4A4038"
            android:maxLines="3"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Claims all the height the quote below doesn't need, so the clock
         row grows with however big the user makes this widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <AnalogClock
                android:id="@+id/widget_clock_analog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/widget_clock_dial"
                android:hand_hour="@drawable/widget_clock_hand_hour"
                android:hand_minute="@drawable/widget_clock_hand_minute" />

            <ImageView
                android:id="@+id/widget_clock_hand_alarm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_clock_hand_alarm"
                android:visibility="gone"
                android:contentDescription="@null" />

        </FrameLayout>

        <TextClock
            android:id="@+id/widget_clock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:format12Hour="a h:mm"
            android:format24Hour="a h:mm"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2B2620" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="문장을 불러오는 중이에요"
        android:textSize="14sp"
        android:textColor="#2B2620"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_attribution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="#8A6438"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>

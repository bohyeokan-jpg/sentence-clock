<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Clock row and quote block split the available height by weight, so
         both get an actual bounded box to work with instead of one being
         wrap_content and silently starving (or overflowing) the other. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <AnalogClock
                android:id="@+id/widget_clock_analog"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dial="@drawable/widget_clock_dial"
                android:hand_hour="@drawable/widget_clock_hand_hour"
                android:hand_minute="@drawable/widget_clock_hand_minute"
                android:hand_second="@drawable/widget_clock_hand_second" />

            <ImageView
                android:id="@+id/widget_clock_hand_alarm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_clock_hand_alarm"
                android:visibility="gone"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- TextClock's "a" (AM/PM) symbol is locale-driven — on a Korean
             device it always renders "오전/오후" no matter what pattern we
             ask for, with no way to force English while it keeps ticking
             on its own. So the AM/PM label is a separate, small, plain
             TextView (widget_meridiem) that Kotlin sets in English —
             everything that actually needs to stay accurate every minute
             (h:mm) is still the native, self-ticking part. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_meridiem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AM"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2B2620" />

            <TextClock
                android:id="@+id/widget_clock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="h:mm"
                android:textSize="52sp"
                android:textStyle="bold"
                android:textColor="#2B2620" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <!-- Bounded (0dp+weight, not wrap_content) so autosize has an actual
             box to shrink the font within — it picks the largest size where
             the *whole* quote fits, wrapped across as many lines as it
             needs, instead of a fixed size that clips long quotes with
             an ellipsis. -->
        <TextView
            android:id="@+id/widget_quote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="문장을 불러오는 중이에요"
            android:textColor="#2B2620"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeStepGranularity="1sp" />

        <TextView
            android:id="@+id/widget_attribution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="18sp"
            android:textColor="#8A6438"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
